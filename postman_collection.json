              ],
              "path": [
                "customers",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<customer-uuid>"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"mobile\": \"+919876543210\",\n  \"businessName\": \"Kumar Traders Pvt Ltd\",\n  \"customerType\": \"DISTRIBUTOR\",\n  \"address\": \"42 MG Road, Bengaluru\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "description": "Updates a customer record. Requires ADMIN or SALES role. Accepts same fields as POST /customers."
          }
        },
        {
          "name": "POST /customers/:id/notes",
          "request": {
            "method": "POST",

              ],
              "path": [
                "products",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<product-uuid>"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse Pro\",\n  \"sku\": \"WM-001\",\n  \"category\": \"Electronics\",\n  \"unitPrice\": 29.99,\n  \"minStockAlert\": 15,\n  \"location\": \"Aisle 3, Shelf B\"\n}"
            },
            "description": "Updates a product. Requires ADMIN or WAREHOUSE role.\n\nIMPORTANT: Do NOT include `currentStock` in the request body — the API will reject it with a 400 error. Stock levels can only be modified via POST /products/:id/stock-movement."
          }
        },
        {
          "name": "POST /products/:id/stock-movement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/:id/stock-movement",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                ":id",
                "stock-movement"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<product-uuid>"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityChanged\": 50,\n  \"movementType\": \"IN\",\n  \"reason\": \"Supplier delivery — PO #1234\"\n}"
            },
            "description": "Records a stock movement. Requires ADMIN or WAREHOUSE role.\n\nmovementType: IN (adds stock) | OUT (deducts stock)\nThe API enforces non-negative stock — an OUT movement that would result in negative stock is rejected with 400."
          }
        },
        {
          "name": "POST /products/:id/image",
          "request": {
            "method": "POST",

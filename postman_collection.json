                }
              ]
            },
            "description": "Deletes a product image from S3. Requires ADMIN or WAREHOUSE role."
          }
        }
      ]
    },
    {
      "name": "Challans",
      "item": [
        {
          "name": "POST /challans",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"<customer-uuid>\",\n  \"items\": [\n    { \"productId\": \"<product-uuid-1>\", \"quantity\": 5 },\n    { \"productId\": \"<product-uuid-2>\", \"quantity\": 3 }\n  ]\n}"
            },
            "description": "Creates a new Sales Challan in DRAFT status. Requires ADMIN or SALES role.\n\nThe product's name, SKU, and unit price are snapshotted into the challan items at creation time — they are permanently locked and will not change even if the product is later updated.\n\nDraft challans do NOT affect inventory."
          }
        },
        {
          "name": "GET /challans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans?page=1&limit=10&status=DRAFT&customerId=<uuid>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "DRAFT",
                  "description": "Filter: DRAFT | CONFIRMED | CANCELLED"
                },
                {
                  "key": "customerId",
                  "value": "<uuid>",
                  "description": "Filter by customer UUID"
                }
              ]
            },
            "description": "Lists challans with pagination and optional status/customer filters. All authenticated roles can access."
          }
        },
        {
          "name": "GET /challans/:id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<challan-uuid>"
                }
              ]
            },
            "description": "Returns full challan detail including customer info, creator info, and all line items with their locked snapshot data."
          }
        },
        {
          "name": "PUT /challans/:id/confirm",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans",
                ":id",
                "confirm"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<challan-uuid>"
                }
              ]
            },
            "description": "Confirms a DRAFT challan. Requires ADMIN or SALES role.\n\nThis operation runs inside a database transaction:\n1. Verifies all items have sufficient stock.\n2. If any item is short, the entire operation is rolled back and a 400 is returned with the specific shortage details.\n3. On success, deducts stock from each product, creates OUT StockMovement records, and marks the challan CONFIRMED."
          }
        },
        {
          "name": "PUT /challans/:id/cancel",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans",
                ":id",
                "cancel"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<challan-uuid>"
                }
              ]
            },
            "description": "Cancels a DRAFT or CONFIRMED challan. Requires ADMIN or SALES role.\n\n- Cancelling a DRAFT: just marks it CANCELLED, no inventory effect.\n- Cancelling a CONFIRMED: runs inside a transaction to restore each item's quantity back to product stock and creates IN StockMovement records."
          }
        },
        {
          "name": "GET /challans/:id/pdf",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "challans",
                ":id",
                "pdf"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<challan-uuid>"
                }
              ]
            },
            "description": "Generates and returns a PDF invoice for a CONFIRMED challan. All authenticated roles can access."
          }
        }
      ]
    }
  ]
}
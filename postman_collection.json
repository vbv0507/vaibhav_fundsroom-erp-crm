            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"sku\": \"WM-001\",\n  \"category\": \"Electronics\",\n  \"unitPrice\": 25.99,\n  \"currentStock\": 0,\n  \"minStockAlert\": 10,\n  \"location\": \"Aisle 3\"\n}"
            },
            "description": "Creates a new product. Requires ADMIN or WAREHOUSE role.\n\nNote: currentStock is the initial stock value set at creation. After creation, all stock changes must go through POST /products/:id/stock-movement."
          }
        },
        {
          "name": "GET /products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&q=Mouse&category=Electronics&lowStock=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "q",
                  "value": "Mouse",
                  "description": "Search by name or SKU"
                },
                {
                  "key": "category",
                  "value": "Electronics",
                  "description": "Exact category filter"
                },
                {
                  "key": "lowStock",
                  "value": "true",
                  "description": "Set true to return only products where currentStock <= minStockAlert"
                }
              ]
            },
            "description": "Lists products with pagination, search, category filter, and low-stock toggle. All authenticated roles can access."
          }
        },
